# Pflegra – Konfiguration
# Kopiere diese Datei nach .env und passe die Werte an:
#   Windows: copy .env.example .env
#   Linux:   cp .env.example .env

# Port (Standard: 8000)
PORT=8000

# Zeitzone
TZ=Europe/Berlin

# Session-Secret (bitte ändern für Produktivbetrieb!)
# Zufälligen Wert generieren: python3 -c "import secrets; print(secrets.token_hex(32))"
PFLEGRA_SECRET=

# HTTPS-Modus (1 = an, wenn hinter Reverse Proxy / Tailscale)
PFLEGRA_HTTPS=0

# Debug-Logging (0 = aus, 1 = an)
PFLEGRA_DEBUG=0

# Uhrzeit für automatisches Backup (0-23)
BACKUP_STUNDE=2
